<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="通知管家"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#16181D" />

        <Button
            android:id="@+id/btn_about"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="关于" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="刷新" />
    </LinearLayout>

    <!-- 未授权提示条 -->
    <LinearLayout
        android:id="@+id/auth_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF4E5"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/auth_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ 还差一步：开启「通知使用权」"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#8A5A00" />

        <TextView
            android:id="@+id/auth_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="开启后本应用才能读取并拦截通知。这是系统提供的标准权限，不会读取你的隐私内容。"
            android:textSize="12sp"
            android:textColor="#8A5A00" />

        <Button
            android:id="@+id/btn_grant"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:text="去开启" />
    </LinearLayout>

    <!-- 电池优化提示条（国产 ROM 必需，否则进程会被冻结） -->
    <LinearLayout
        android:id="@+id/battery_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E8F0FE"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 建议：允许本应用在后台运行"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A3C7A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="手机系统可能会冻结后台应用，导致拦截失效。加入电池优化白名单后更稳定。"
            android:textSize="12sp"
            android:textColor="#1A3C7A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_battery"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:textSize="13sp"
                android:text="去设置" />

            <Button
                android:id="@+id/btn_battery_ignore"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:text="不再提示" />
        </LinearLayout>
    </LinearLayout>

    <!-- 状态栏 -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:textColor="#5A6270"
        android:background="#F5F7FA"
        android:text="准备中 …" />

    <!-- 搜索行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="搜索应用名称或包名"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="清空" />
    </LinearLayout>

    <!-- 过滤行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btn_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:text="新装应用" />

        <Button
            android:id="@+id/btn_system"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:text="显示系统" />

        <Button
            android:id="@+id/btn_blocked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:text="只看已拦" />
    </LinearLayout>

    <!-- 批量行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btn_block_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:text="全部拦截" />

        <Button
            android:id="@+id/btn_allow_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:text="全部恢复" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EBF0" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#F0F2F5"
        android:dividerHeight="1dp"
        android:cacheColorHint="#00000000" />
</LinearLayout>
